/* ANON-X Privacy Center Dark Cybersecurity Theme */

QMainWindow, QWidget {
    background-color: #0b0f17;
    color: #e5e7eb;
    font-family: "Inter", "Segoe UI", "DejaVu Sans", sans-serif;
    font-size: 13px;
}

#Sidebar {
    background-color: #070a10;
    border-right: 1px solid #1f2937;
}

#SidebarTitle {
    color: #38bdf8;
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 1.5px;
    padding: 12px 8px;
}

QPushButton#NavButton {
    background-color: transparent;
    color: #9ca3af;
    border: none;
    border-radius: 8px;
    padding: 10px 14px;
    text-align: left;
    font-weight: 600;
}

QPushButton#NavButton:hover {
    background-color: #111827;
    color: #f9fafb;
}

QPushButton#NavButton[active="true"] {
    background-color: #0f2942;
    color: #38bdf8;
    border-left: 3px solid #38bdf8;
}

QFrame#Card {
    background-color: #111827;
    border: 1px solid #1f2937;
    border-radius: 12px;
}

QFrame#HeroCard {
    background-color: #0d1522;
    border: 1px solid #1e3a5f;
    border-radius: 14px;
}

QLabel#PageTitle {
    color: #f9fafb;
    font-size: 20px;
    font-weight: 700;
}

QLabel#CardTitle {
    color: #93c5fd;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.8px;
}

QLabel#MetricValue {
    color: #f9fafb;
    font-size: 16px;
    font-weight: 700;
}

QLabel#StatusBadge {
    padding: 4px 10px;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 700;
}

QPushButton#PrimaryAction {
    background-color: #0284c7;
    color: #ffffff;
    border: none;
    border-radius: 10px;
    padding: 12px 24px;
    font-size: 14px;
    font-weight: 700;
}

QPushButton#PrimaryAction:hover {
    background-color: #0ea5e9;
}

QPushButton#DangerAction {
    background-color: #991b1b;
    color: #ffffff;
    border: 1px solid #ef4444;
    border-radius: 10px;
    padding: 12px 24px;
    font-size: 14px;
    font-weight: 700;
}

QPushButton#DangerAction:hover {
    background-color: #dc2626;
}

QPushButton#SecondaryButton {
    background-color: #1f2937;
    color: #e5e7eb;
    border: 1px solid #374151;
    border-radius: 8px;
    padding: 8px 16px;
    font-weight: 600;
}

QPushButton#SecondaryButton:hover {
    background-color: #374151;
}

QTableWidget, QTextEdit, QPlainTextEdit, QLineEdit, QComboBox {
    background-color: #090d16;
    color: #e5e7eb;
    border: 1px solid #1f2937;
    border-radius: 8px;
    padding: 6px;
}

QHeaderView::section {
    background-color: #111827;
    color: #38bdf8;
    border: none;
    padding: 8px;
    font-weight: 700;
}

QProgressBar {
    background-color: #1f2937;
    border-radius: 6px;
    text-align: center;
    color: #ffffff;
    font-weight: 700;
}

QProgressBar::chunk {
    background-color: #10b981;
    border-radius: 6px;
}
